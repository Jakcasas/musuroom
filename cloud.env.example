# Sao chep thanh data/cloud.env. File template khong chua khoa/mat khau.
# MongoDB Atlas primary + GridFS. PostgreSQL/Supabase entries remain blank.
DATABASE_PROVIDER=mongodb
DATABASE_PATH=data/musuroom.sqlite
DATABASE_URL=
DATABASE_CA_CERT=
STORAGE_PROVIDER=mongodb
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=musuroom-dossier
NODE_ENV=development
PUBLIC_ORIGIN=https://musuroom-web-production.up.railway.app
AI_PROVIDER=disabled
OPENROUTER_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=700
AI_CONTEXT_MAX_CHARS=12000
AI_MAX_CONCURRENT=2
AI_COOLDOWN_MS=30000
CHAT_REQUESTS_PER_MINUTE=10
INSIGHTS_REQUESTS_PER_MINUTE=10
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=typesafe-ai/jev
JEV_MIN_CONFIDENCE=0.65
AUTH_SESSION_MINUTES=120
AUTH_IDLE_MINUTES=20
AUTH_LOGIN_LIMIT=8
JUDGE_DEFAULT_ACCOUNT_ID=
JUDGE_BOOTSTRAP_CODE=
ADMIN_BOOTSTRAP_CODE=
MONGO_ENABLED=true
MONGODB_URI=
MONGODB_DATABASE=musuroom
MONGO_SOURCE_ID=musuroom-production
MONGO_JEV_ENRICHMENT=false
MONGO_SYNC_BATCH_SIZE=25
MONGO_SYNC_INTERVAL_MS=60000
MONGO_JEV_MAX_PER_RUN=10

# Official JevAI MCP transport
JEV_TRANSPORT=mcp
