{
  "name": "musuroom",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "Musuroom 1: Express, Atlas JSON projection, optional legacy PostgreSQL/Supabase and Jev",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/database.mjs",
    "access:create": "node scripts/create-access.mjs",
    "access:revoke": "node scripts/revoke-access.mjs",
    "access:change-judge": "node scripts/change-judge-code.mjs",
    "dossier:add": "node scripts/add-document.mjs",
    "docs:search": "node scripts/search-typesafe.mjs",
    "jev:check": "node scripts/check-jev.mjs",
    "jev:diagnose": "node scripts/diagnose-jev.mjs",
    "mcp:install-jev": "node scripts/install-jev-mcp.mjs",
    "qr:generate": "node scripts/generate-qr.mjs",
    "cloud:check": "node scripts/cloud-preflight.mjs",
    "cloud:configure": "node scripts/railway-configure.mjs",
    "cloud:deploy": "node scripts/deploy-cloud.mjs",
    "data:export": "node scripts/export-data.mjs",
    "data:sync": "node scripts/sync-mongo.mjs",
    "schema:postgres": "node scripts/build-postgres-schema.mjs",
    "check": "node scripts/check-project.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "db:check-history": "node scripts/check-migration-history.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "5.2.1",
    "mongodb": "7.7.0",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@railway/cli": "5.63.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  }
}
