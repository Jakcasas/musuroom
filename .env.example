# Local server (Node.js 24+)
HOST=127.0.0.1
PORT=8766
NODE_ENV=development
DATABASE_PATH=./data/musuroom.sqlite
DATABASE_PROVIDER=sqlite
# Cloud: DATABASE_PROVIDER=mongodb; STORAGE_PROVIDER=mongodb; MONGO_ENABLED=true.
# PostgreSQL/Supabase are optional legacy integrations, not required for Railway.
DATABASE_URL=
DATABASE_CA_CERT=
PUBLIC_ORIGIN=
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=musuroom-dossier
# Generated by: node scripts/setup.mjs. Keep private.
API_WRITE_TOKEN=
# AI optional: disabled | openrouter
AI_PROVIDER=disabled
OPENROUTER_API_KEY=
# Set an exact model ID from your OpenRouter account before enabling AI.
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=700
AI_CONTEXT_MAX_CHARS=12000
AI_MAX_CONCURRENT=2
AI_COOLDOWN_MS=30000
CHAT_REQUESTS_PER_MINUTE=10
INSIGHTS_REQUESTS_PER_MINUTE=10
AUTH_SESSION_MINUTES=120
AUTH_IDLE_MINUTES=20
AUTH_LOGIN_LIMIT=8
# Optional password-only login for one existing JUDGE account. Code remains hashed in SQL.
JUDGE_DEFAULT_ACCOUNT_ID=
# Optional server-only bootstrap codes. Keep them in .env/Railway Variables only.
JUDGE_BOOTSTRAP_CODE=
ADMIN_BOOTSTRAP_CODE=
# TypeSafe Jev: typed suggestions for comments and public knowledge.
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=typesafe-ai/jev
JEV_MIN_CONFIDENCE=0.65
# MongoDB Atlas JSON projection and processing. Server-only URI.
MONGO_ENABLED=false
MONGODB_URI=
MONGODB_DATABASE=musuroom
MONGO_SOURCE_ID=musuroom-local
MONGO_JEV_ENRICHMENT=false
MONGO_SYNC_BATCH_SIZE=25
MONGO_SYNC_INTERVAL_MS=60000
MONGO_JEV_MAX_PER_RUN=10

# Official JevAI transport: rest (default) or mcp
JEV_TRANSPORT=mcp
